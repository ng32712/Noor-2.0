{
  "id": "/",
  "name": "Qur'anLearn — Qur'an Teaching & Memorization",
  "short_name": "Qur'anLearn",
  "description": "Listen, recite and memorize the Qur'an with word-by-word tracking, tajweed lessons and smart revision. Works offline once installed.",
